# Copy this file to .env and fill in your own values.
# Port 5000 is taken by macOS AirPlay Receiver, so this project uses 5050.
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/safety-app
CLIENT_ORIGIN=http://localhost:5173

# Nominatim requires an identifying User-Agent with contact info.
# See: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=LGBTQIA-Safety-App/1.0 (everose7023@gmail.com)

# Reddit API (r/TransSurgeriesWiki). Register a "script" app at
# https://www.reddit.com/prefs/apps -- it is free. The client id is the string
# under the app name; the secret is labelled "secret".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=macos:lgbtqia-safety-app:v1.0 (by /u/yourusername)
