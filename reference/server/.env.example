# Copy this file to .env and fill in your own values.
# Port 5000 is taken by macOS AirPlay Receiver, so this project uses 5050.
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/safety-app
CLIENT_ORIGIN=http://localhost:5173

# Nominatim requires an identifying User-Agent with contact info.
# See: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=LGBTQIA-Safety-App/1.0 (everose7023@gmail.com)
